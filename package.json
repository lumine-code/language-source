{
  "name": "language-source",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Base source file support.",
  "keywords": [
    "base-grammar",
    "fallback",
    "generic"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "specPackages": [
    "language-csv"
  ],
  "repository": "https://github.com/lumine-code/language-source",
  "license": "MIT",
  "files": [
    "settings",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "bugs": {
    "url": "https://github.com/lumine-code/language-source/issues"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.8"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.8"
    }
  }
